{
  "name": "@himanshujangir/frank",
  "version": "0.2.1",
  "description": "Local receipt and pushback guardrails for AI coding agents.",
  "keywords": [
    "opencode-plugin",
    "opencode",
    "claude-code",
    "codex",
    "anti-sycophancy",
    "skills",
    "frank"
  ],
  "license": "MIT",
  "author": {
    "name": "Himanshu Jangir",
    "url": "https://github.com/HimanshuJ16"
  },
  "homepage": "https://github.com/HimanshuJ16/frank",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HimanshuJ16/frank.git"
  },
  "bugs": {
    "url": "https://github.com/HimanshuJ16/frank/issues"
  },
  "type": "module",
  "main": "./.opencode/plugins/frank.mjs",
  "exports": {
    ".": "./.opencode/plugins/frank.mjs",
    "./plugin": "./.opencode/plugins/frank.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "AGENTS.md",
    "rules/",
    "hooks/",
    "skills/",
    "commands/",
    "scripts/",
    ".opencode/",
    ".qoder/",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-rule-copies.js && node scripts/check-versions.js && node --test",
    "build:adapters": "node scripts/build-adapters.js",
    "bench:pushback": "node benchmarks/pushback/run.js",
    "stats": "node scripts/stats.js",
    "count": "node scripts/count.js",
    "uninstall": "node scripts/uninstall.js",
    "site": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
